{
  "name": "arcade-font-engine",
  "author": "flameshikari",
  "homepage": "https://github.com/flameshikari/arcade-font-engine",
  "type": "module",
  "scripts": {
    "clear": "mkdir -p public && rm -rf public/*",
    "copy": "mkdir -p public && cp -rf client/static/* public",
    "build:dev": "bun run check:compat && bun run clear && bun run copy && NODE_ENV=development bun client/index.js",
    "build:prod": "bun run check:compat && bun run clear && bun run copy && NODE_ENV=production bun client/index.js",
    "start": "nodemon --exec 'bun run build:dev'",
    "check:compat": "bun --bun run eslint client/scripts --max-warnings 0"
  },
  "imports": {
    "#root": "."
  },
  "nodemonConfig": {
    "ignore": [
      "public/*",
      "node_modules/*"
    ],
    "delay": 500,
    "watch": [
      "."
    ],
    "ext": "cjs, css, js, json, md, mjs, njk, html, png"
  },
  "browserslist": [
    "> 0.01%",
    "not dead"
  ],
  "devDependencies": {
    "@chialab/esbuild-plugin-babel": "^0.19.1",
    "@chialab/esbuild-plugin-html": "^0.19.1",
    "bigger-picture": "1.1.20",
    "browserslist-to-esbuild": "^2.1.1",
    "core-js": "^3.51.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-compat": "^7.0.2",
    "htmlnano": "^3.6.1",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "nodemon": "^3.1.14",
    "rcpy": "^1.0.2",
    "relateurl": "^0.2.7",
    "srcset": "^5.0.3",
    "terser": "^5.51.2"
  },
  "version": "1.1.0",
  "patchedDependencies": {
    "bigger-picture@1.1.20": "patches/bigger-picture@1.1.20.patch"
  }
}
